#!/command/with-contenv bash
# shellcheck shell=bash

set -eu

. /usr/local/bin/backend-functions

# Run the configuration script
log "Run the motd"
/usr/local/bin/motd

log "Starting NordVPN service - $(date '+%Y-%m-%d %H:%M:%S')"

# Add additional start up options
if ! echo "$OPENVPN_OPTS" | grep -q -- "--data-ciphers"; then
    log "Adding default --data-ciphers"
    OPENVPN_OPTS="$OPENVPN_OPTS --data-ciphers AES-256-CBC:AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305"
fi

log "Launching OpenVPN"
openvpn --group nordvpn --config "$OVPN_FILE" --auth-user-pass "$OVPN_AUTH_FILE" --auth-nocache --management "$MGMT_SOCK_FILE" unix $OPENVPN_OPTS &
VPN_PID=$!

# 6. Wait and Monitor
log "Waiting for VPN connection..."
counter=0
while ! is_vpn_connected && [ $counter -lt 30 ]; do
    # Check if the process is still alive
    if ! kill -0 $VPN_PID 2>/dev/null; then
        log_error "OpenVPN process died immediately"
        exit 1
    fi
    sleep 2
    counter=$((counter + 1))
done

if is_vpn_connected; then
    log "VPN connection established successfully"

    if [ "${NETWORK_DIAGNOSTIC_ENABLED:-false}" = "true" ] || [ "${NETWORK_DIAGNOSTIC_ENABLED:-0}" = "1" ]; then
        log "Running network diagnostic..."
        network-diagnostic
    fi

    # 8. Keep script alive by waiting for OpenVPN
    log "Monitoring OpenVPN process (PID: $VPN_PID)"

    # Keeping the service alive
    wait $VPN_PID
else
    log_error "VPN timed out"
    kill $VPN_PID 2>/dev/null
    exit 1
fi
