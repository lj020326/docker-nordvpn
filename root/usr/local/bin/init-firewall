#!/bin/bash
# shellcheck shell=bash

set -eu
. /usr/local/bin/backend-functions

log "Starting firewall initialization"

# 1. Parse NORDVPNAPI_IP into an Array
# This handles both space, comma, and semicolon separators reliably
IFS=',; ' read -ra API_IPS <<< "${NORDVPNAPI_IP:-}"
log "Using API IPs: ${API_IPS[*]}"

# 2. CLEAN SLATE & LOCKDOWN
log "Clearing any nft rules if legacy backend chosen"
flush_nft_if_dirty_v4
flush_nft_if_dirty_v6

log "Setting default DROP policies"
for cmd in run4_critical run6_critical; do
    $cmd -t filter -P INPUT   DROP
    $cmd -t filter -P OUTPUT  DROP
    $cmd -t filter -P FORWARD DROP
done

log "Flushing existing rules and chains"
for table in filter nat; do
    run4_critical -t "$table" -F
    run4_critical -t "$table" -X
    run6_critical -t "$table" -F
    run6_critical -t "$table" -X
done

# 3. ESSENTIAL RULES (same as v1)
log "Allow loopback"
run4 -A INPUT  -i lo -j ACCEPT
run4 -A OUTPUT -o lo -j ACCEPT

log "Allow established/related (return traffic)"
run4 -A INPUT  -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
run4 -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
run4 -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# 4. NETWORK DETECTION
docker_network=$(ip addr show dev eth0 2>/dev/null | awk '/inet / {print $2}' | head -1)
gw=$(ip route | awk '/default/ {print $3}' | head -1)

# 5. DNS & API bootstrap (keep latest's safety)
log "Allow DNS outbound"
run4 -A OUTPUT -p udp --dport 53 -j ACCEPT
run4 -A OUTPUT -p tcp --dport 53 -j ACCEPT

log "Allow HTTPS outbound for API"
run4 -A OUTPUT -p tcp --dport 443 -j ACCEPT

if [[ ${#API_IPS[@]} -gt 0 ]]; then
    log "Allowing NordVPN API bootstrap to: ${API_IPS[*]}"
    for ip in "${API_IPS[@]}"; do
        [[ -z "$ip" ]] && continue
        log_debug "Allowing ping & HTTPS to Nord API: ${ip}"
        run4 -A OUTPUT -d "$ip" -p icmp -j ACCEPT
        run4 -A OUTPUT -d "$ip" -p tcp --dport 443 -j ACCEPT
    done

    log "Run API connection tests for IPs: ${NORDVPNAPI_IP}"
    api-connection-tests
fi

# 6. CUSTOM NETWORK ACCESS (your LAN subnets)
IFS=',; ' read -ra CUSTOM_NETS <<< "${NETWORK:-}"
if [[ ${#CUSTOM_NETS[@]} -gt 0 ]]; then
    log "Allowing custom networks: ${CUSTOM_NETS[*]}"
    for net in "${CUSTOM_NETS[@]}"; do
        [[ -z "$net" ]] && continue
        # Add route if needed
        if [[ -n "$gw" ]]; then
            log "Adding route to custom network [$net] gateway: ${gw}"
            ip route add "$net" via "$gw" dev eth0 2>/dev/null || true
        fi
        # v1-style: allow in INPUT, OUTPUT, FORWARD
        run4 -A INPUT  -s "$net" -j ACCEPT
        run4 -A OUTPUT -d "$net" -j ACCEPT
        run4 -A FORWARD -s "$net" -j ACCEPT
        run4 -A FORWARD -d "$net" -j ACCEPT
    done
fi

# 7. STRICT VPN-ONLY OUTBOUND (like v1)
log "Routing all other outbound through VPN only"
run4 -N VPN-SERVER
run4 -A OUTPUT -j VPN-SERVER

# Only allow OpenVPN protocol ports
run4 -A VPN-SERVER -p udp --dport 1194 -j ACCEPT
run4 -A VPN-SERVER -p tcp --dport 443  -j ACCEPT

# 8. EXTRA PROTECTION: Drop NEW incoming on non-tun interfaces
# This prevents any unsolicited incoming (torrent, etc.) via host IP
log "Blocking NEW incoming connections except on tun/tap/lo"
run4 -I INPUT ! -i lo ! -i tun+ ! -i tap+ -m conntrack --ctstate NEW -j DROP

log "Firewall initialization complete - strict non-leaking mode (v1 style)"
